# Alumni Influencers Portal - Example Environment Configuration

# --------------------------------------------------
# Application Settings
# --------------------------------------------------
BASE_URL="http://localhost/alumini_api_cw/"
ENVIRONMENT="development"

# --------------------------------------------------
# Database Configuration
# --------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASS=""
DB_NAME="cw1_alumini_influencers"

# --------------------------------------------------
# Security and Encryption
# --------------------------------------------------
ENCRYPTION_KEY="replace_with_a_secure_codeigniter_encryption_key"

# --------------------------------------------------
# JWT Authentication
# --------------------------------------------------
JWT_SECRET_KEY="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRATION_TIME="3600"

# --------------------------------------------------
# API Security
# --------------------------------------------------
API_RATE_LIMIT="100"
API_RATE_LIMIT_WINDOW="60"

# --------------------------------------------------
# Client API Key
# --------------------------------------------------
DASHBOARD_API_KEY="replace_with_dashboard_client_api_key"

# --------------------------------------------------
# Optional File Upload Settings
# --------------------------------------------------
UPLOAD_PATH="./uploads/"
MAX_UPLOAD_SIZE="2048"

# --------------------------------------------------
# Optional Frontend/Admin Settings
# --------------------------------------------------
ADMIN_CLIENT_URL="http://localhost/alumini_api_cw/admin_client/"