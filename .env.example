#Alumni Influencers Portal - Environment Configs

#Application Settings
BASE_URL="http://localhost/alumini_api_cw/"
ENVIRONMENT="development"

#Database Configuration
DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="cw1_alumini_influencers"

#Security and Encryption
ENCRYPTION_KEY="your_codeigniter_encryption_key_here"

#JWT Authentication
JWT_SECRET_KEY="your_super_secret_jwt_key_here"
JWT_EXPIRATION_TIME=3600 #Token expiry in seconds

#API Security Limits
API_RATE_LIMIT=100 #Maximum requests per hour per user

#Email Configuration (For Bid Notifications/Resets)
SMTP_PROTOCOL="smtp"
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_USER="your_mailtrap_username"
SMTP_PASS="your_mailtrap_password"
SMTP_PORT=2525